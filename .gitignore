# --- Go 构建产物 ---
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# --- 覆盖率 ---
coverage.out
coverage.html

# --- 本地配置 / 密钥（永不入库） ---
.env
.env.*
!.env.example
config.local.yaml
config.local.yml

# --- 前端 ---
node_modules/
web/dist/
web/.vite/
web/node_modules/
*.local
# vitest 运行期生成的临时 config（web/vitest.config.ts.timestamp-*.mjs）
web/*.timestamp-*.mjs

# --- Python（临时辅助脚本遗留） ---
__pycache__/
*.py[cod]

# --- 调试/临时产物（禁止入库） ---
_tmp/
_probe.txt
_tree.txt
_*.txt
# 验证脚本的运行产物：服务日志（scripts/verify-*.py 落 _verify_*_srv.log）
# 与 UI 截图（verify-images.py 落 _verify_ui.png）——每次跑都重新生成，
# 入库只会制造无意义 diff；M6 的 UI 交付证据是 screenshots/ 那三张，另行入库。
_*.log
_*.png
# E2E 编排器的阶段 JSON 与日志（scripts/verify-e2e.py 落 scripts/_e2e/）
scripts/_e2e/

# --- 编辑器 / 系统 ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- 嵌套克隆（GitHub Desktop 会把远程仓库 clone 到仓库根下同名目录，
#     它是 0 commit 的空仓库，既污染工作树又会让 Desktop 选错目录）---
/IIP/
